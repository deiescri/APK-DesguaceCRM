                        android:text="USB / Wi-Fi local"
                        android:textColor="#94A3B8"
                        android:textSize="10sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- MANTENEMOS ELEMENTOS OCULTOS PARA COMPATIBILIDAD CON ID DE VISTAS Y MENÚS -->
            <LinearLayout
                android:id="@+id/llMenuAccesosRapidos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <Button
                    android:id="@+id/btnNuevaLlamada"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Registrar llamada" />

                <Button
                    android:id="@+id/btnBuscarPieza"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Buscar pieza" />

                <Button
                    android:id="@+id/btnCopiasSeguridad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Copias" />

                <Button
                    android:id="@+id/btnImportarCatalogoVehiculos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Importar" />

                <Button
                    android:id="@+id/btnVerLlamadas"
