<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <!-- FONDO DE PANTALLA LIQUID GLASS CONTINUO -->
    <ImageView
        android:id="@+id/imgFondoLiquidGlass"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Fondo Liquid Glass"
        android:scaleType="centerCrop"
        android:src="@drawable/img_splash_car" />

    <!-- OVERLAY SUTIL PARA MANTENER NITIDEZ DE LA IMAGEN DE FONDO -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#33000000" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="28dp">

            <!-- CABECERA LIQUID GLASS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_card_28dp"
                android:elevation="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="18dp"
                android:paddingVertical="16dp">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="12dp"
                    android:contentDescription="Logo DesguaceCRM"
                    android:src="@drawable/ic_recycling" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtTituloFormulario"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Registrar llamada"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DesguaceCRM · Gestión de clientes"
                        android:textColor="#94A3B8"
                        android:textSize="12sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- SECCIÓN 1: DATOS DEL CLIENTE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_glass_card_28dp"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="DATOS DEL CLIENTE"
                    android:textColor="#38BDF8"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etTelefono"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_glass_input_14dp"
                    android:hint="Número de teléfono *"
                    android:inputType="phone"
                    android:paddingHorizontal="16dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#94A3B8"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/etNombre"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_glass_input_14dp"
                    android:hint="Nombre del cliente"
                    android:inputType="textPersonName"
                    android:paddingHorizontal="16dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#94A3B8"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- SECCIÓN 2: DATOS DEL VEHÍCULO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_glass_card_28dp"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="DATOS DEL VEHÍCULO"
                    android:textColor="#38BDF8"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <AutoCompleteTextView
                    android:id="@+id/etMarca"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_glass_input_14dp"
                    android:hint="Marca (Ej. SEAT, AUDI)..."
                    android:inputType="text"
                    android:paddingHorizontal="16dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#94A3B8"
                    android:textSize="14sp" />

                <AutoCompleteTextView
                    android:id="@+id/etModelo"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_glass_input_14dp"
                    android:hint="Modelo (Ej. Ibiza, León)..."
                    android:inputType="text"
                    android:paddingHorizontal="16dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#94A3B8"
                    android:textSize="14sp" />

                <AutoCompleteTextView
                    android:id="@+id/etMotor"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_glass_input_14dp"
                    android:hint="Motor / Código motor (Ej. 1.9 TDI BKD)..."
                    android:inputType="text"
                    android:paddingHorizontal="16dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#94A3B8"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/etAnio"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_glass_input_14dp"
                    android:hint="Año de fabricación"
                    android:inputType="number"
                    android:paddingHorizontal="16dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#94A3B8"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- SECCIÓN 3: PIEZA Y DETALLES -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_glass_card_28dp"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="PIEZA SOLICITADA Y OBSERVACIONES"
                    android:textColor="#38BDF8"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etPieza"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_glass_input_14dp"
                    android:hint="Nombre de la pieza (Ej. Alternador, Caja)..."
                    android:inputType="text"
                    android:paddingHorizontal="16dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#94A3B8"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/etApuntes"
                    android:layout_width="match_parent"
                    android:layout_height="90dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_glass_input_14dp"
                    android:gravity="top"
                    android:hint="Observaciones o notas adicionales..."
                    android:inputType="textMultiLine"
                    android:padding="14dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#94A3B8"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- BOTONES DE ACCIÓN (NUEVA CÁPSULA 52dp DE ALTURA SIN TEXTO CORTADO) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnGuardarLlamada"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:backgroundTint="#2563EB"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:text="💾 Guardar Llamada"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnCancelarForm"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:backgroundTint="#334155"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:text="Cancelar"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- VISTAS DE COMPATIBILIDAD OCULTAS PARA CallFormActivity.kt -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone">

                <ImageButton android:id="@+id/btnLlamarCliente" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <Button android:id="@+id/btnReservarPiezaSeleccionada" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <ImageButton android:id="@+id/btnBuscarPiezaStock" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <ImageButton android:id="@+id/btnEliminarLlamada" android:layout_width="wrap_content" android:layout_height="wrap_content" />

                <EditText android:id="@+id/etCodigoStock" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <EditText android:id="@+id/etUbicacionStock" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <EditText android:id="@+id/etOEM" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <EditText android:id="@+id/etDescripcion" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <EditText android:id="@+id/etLado" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <EditText android:id="@+id/etCodigosMotor" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <EditText android:id="@+id/etCombustible" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <EditText android:id="@+id/etPuertas" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <EditText android:id="@+id/etPotenciaCv" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <EditText android:id="@+id/etPotenciaKw" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <EditText android:id="@+id/etRangoFabricacion" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <EditText android:id="@+id/etPrecioVenta" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <EditText android:id="@+id/etFechaVenta" android:layout_width="wrap_content" android:layout_height="wrap_content" />

                <RadioGroup android:id="@+id/rgEstado" android:layout_width="wrap_content" android:layout_height="wrap_content">
                    <RadioButton android:id="@+id/rbPendiente" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <RadioButton android:id="@+id/rbReservada" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <RadioButton android:id="@+id/rbSinExistencias" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <RadioButton android:id="@+id/rbVendido" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <RadioButton android:id="@+id/rbNoConcretada" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </RadioGroup>

                <RadioGroup android:id="@+id/rgTipoLlamada" android:layout_width="wrap_content" android:layout_height="wrap_content">
                    <RadioButton android:id="@+id/rbContestada" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <RadioButton android:id="@+id/rbPerdida" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </RadioGroup>

                <Spinner android:id="@+id/spMotivoNoConcretada" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <LinearLayout android:id="@+id/layoutMotivoNoConcretada" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" />
                <LinearLayout android:id="@+id/layoutDatosVenta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" />
                <CheckBox android:id="@+id/chkGuardarVehiculoCatalogo" android:layout_width="wrap_content" android:layout_height="wrap_content" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</FrameLayout>